import { useMemo } from "react";
import { TrendingUp, Users, CheckCircle2, Clock, Award } from "lucide-react";
import { formatZar, MIN_PAYOUT_ZAR, type ReferralRow, type AffiliateSummary } from "@/lib/affiliate";

interface InsightsProps {
  summary: AffiliateSummary | null | undefined;
  referrals: ReferralRow[];
}

export function AffiliateInsights({ summary, referrals }: InsightsProps) {
  const stats = useMemo(() => {
    const total = referrals.length;
    const paid = referrals.filter((r) => r.status === "paid").length;
    const pending = referrals.filter((r) => r.status === "signed_up").length;
    const conversionRate = total > 0 ? Math.round((paid / total) * 100) : 0;

    // Calculate average days to payment
    const paidWithDates = referrals.filter((r) => r.status === "paid" && r.paid_at);
    let avgDaysToPaid = 0;
    if (paidWithDates.length > 0) {
      const totalMs = paidWithDates.reduce((acc, r) => {
        const diff = new Date(r.paid_at!).getTime() - new Date(r.created_at).getTime();
        return acc + Math.max(0, diff);
      }, 0);
      avgDaysToPaid = Math.round(totalMs / paidWithDates.length / (1000 * 60 * 60 * 24));
    }

    // Payout milestone progress towards R400
    const balanceCents = summary?.balance_cents ?? 0;
    const minPayoutCents = MIN_PAYOUT_ZAR * 100;
    const progressPercent = Math.min(100, Math.round((balanceCents / minPayoutCents) * 100));

    return { total, paid, pending, conversionRate, avgDaysToPaid, progressPercent, balanceCents };
  }, [referrals, summary]);

  return (
    <div className="pw-card space-y-5 p-5">
      <div className="flex items-center justify-between">
        <div>
          <div className="flex items-center gap-2">
            <TrendingUp className="h-4 w-4 text-bull" />
            <h3 className="pw-title text-base">Performance Insights</h3>
          </div>
          <p className="text-xs text-muted-foreground mt-0.5">
            Real-time conversion metrics and payout milestone tracking
          </p>
        </div>
        <span className="rounded-full border border-bull/30 bg-bull/10 px-3 py-1 font-mono text-xs font-semibold text-bull">
          {stats.conversionRate}% Conversion
        </span>
      </div>

      {/* Grid of Key Insights */}
      <div className="grid grid-cols-2 gap-3 sm:grid-cols-4">
        <div className="pw-card-quiet p-3">
          <p className="pw-label text-[10px] text-muted-foreground">Total Leads</p>
          <div className="mt-1 flex items-center gap-1.5">
            <Users className="h-3.5 w-3.5 text-primary" />
            <p className="font-mono text-base font-bold">{stats.total}</p>
          </div>
          <p className="mt-1 text-[10px] text-muted-foreground">{stats.pending} awaiting payment</p>
        </div>

        <div className="pw-card-quiet p-3">
          <p className="pw-label text-[10px] text-muted-foreground">Paid Conversions</p>
          <div className="mt-1 flex items-center gap-1.5">
            <CheckCircle2 className="h-3.5 w-3.5 text-bull" />
            <p className="font-mono text-base font-bold text-bull">{stats.paid}</p>
          </div>
          <p className="mt-1 text-[10px] text-muted-foreground">R200 per sale</p>
        </div>

        <div className="pw-card-quiet p-3">
          <p className="pw-label text-[10px] text-muted-foreground">Avg. Turnaround</p>
          <div className="mt-1 flex items-center gap-1.5">
            <Clock className="h-3.5 w-3.5 text-neutral" />
            <p className="font-mono text-base font-bold">
              {stats.avgDaysToPaid === 0 ? "< 1 day" : `${stats.avgDaysToPaid}d`}
            </p>
          </div>
          <p className="mt-1 text-[10px] text-muted-foreground">Signup to payment</p>
        </div>

        <div className="pw-card-quiet p-3">
          <p className="pw-label text-[10px] text-muted-foreground">Next Payout</p>
          <div className="mt-1 flex items-center gap-1.5">
            <Award className="h-3.5 w-3.5 text-primary" />
            <p className="font-mono text-base font-bold">{stats.progressPercent}%</p>
          </div>
          <p className="mt-1 text-[10px] text-muted-foreground">Min. R{MIN_PAYOUT_ZAR}</p>
        </div>
      </div>

      {/* Payout Progress Bar */}
      <div className="space-y-1.5 pt-1">
        <div className="flex justify-between text-xs font-mono">
          <span className="text-muted-foreground">Payout Progress ({formatZar(stats.balanceCents)} / R{MIN_PAYOUT_ZAR})</span>
          <span className={stats.progressPercent >= 100 ? "text-bull font-bold" : "text-primary"}>
            {stats.progressPercent >= 100 ? "Eligible for EFT payout! 🎉" : `${100 - stats.progressPercent}% to unlock`}
          </span>
        </div>
        <div className="h-2 w-full overflow-hidden rounded-full bg-black/60 border border-primary/20">
          <div
            className="h-full bg-gradient-to-r from-primary to-bull transition-all duration-500"
            style={{ width: `${stats.progressPercent}%` }}
          />
        </div>
      </div>
    </div>
  );
}
